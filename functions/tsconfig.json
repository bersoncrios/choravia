{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "lib",
    "types": ["node"],
    "declaration": false
  },
  "include": ["src/**/*.ts", "../src/app/domain/**/*.ts"]
}
