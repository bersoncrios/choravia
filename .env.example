# Copy to .env.local to use the local Emulator Suite. Never put service-account credentials here.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_PROJECT_ID=demo-wildwoods
VITE_FIREBASE_AUTH_DOMAIN=demo-wildwoods.firebaseapp.com
VITE_FIREBASE_EMULATORS=true
# Production requires a real Firebase project, anonymous Auth enabled if used,
# deployed Firestore rules/indexes and an authorized Auth domain. App Check is not used.
